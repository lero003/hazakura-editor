+    init(directory: URL) throws {
+        let metadataURL = directory.appendingPathComponent("meta.json")
+        guard let metadataSize = try? metadataURL.resourceValues(forKeys: [.fileSizeKey]).fileSize,
+            metadataSize > 0, metadataSize <= 64 * 1024 else {
+            throw KitGemmaError.bufferAllocationFailed("meta.json")
+        }
+        let metadata = try JSONSerialization.jsonObject(with: Data(contentsOf: metadataURL))
+            as? [String: Any]
+        guard let vocab = metadata?["V"] as? Int, vocab > 0,
+            let rowElements = metadata?["PLD"] as? Int, rowElements > 0
+        else {
+            throw KitGemmaError.missingTableFile("meta.json")
+        }
+        let (tableBytes, overflow) = vocab.multipliedReportingOverflow(by: rowElements)
+        let (_, rowByteOverflow) = rowElements.multipliedReportingOverflow(
+            by: MemoryLayout<Float16>.size)
+        guard !overflow, !rowByteOverflow else {
+            throw KitGemmaError.bufferAllocationFailed("embed_per_layer.i8")
+        }
+        self.vocabCount = vocab
+        self.rowElements = rowElements
+        self.embeddingScale = 16  // sqrt(256), Gemma 4's per-layer embedding width.
+        let (scaleBytes, scaleOverflow) = vocab.multipliedReportingOverflow(
+            by: MemoryLayout<Float>.size)
+        let scaleURL = directory.appendingPathComponent("embed_per_layer.scale.f32")
+        guard !scaleOverflow,
+            let scaleFileBytes = try? scaleURL.resourceValues(forKeys: [.fileSizeKey]).fileSize,
+            scaleFileBytes == scaleBytes else {
+            throw KitGemmaError.bufferAllocationFailed("embed_per_layer.scale.f32")
+        }
+        let scaleData = try Data(contentsOf: scaleURL)
+        guard scaleData.count == scaleBytes else {
+            throw KitGemmaError.bufferAllocationFailed("embed_per_layer.scale.f32")
+        }
+        self.scales = scaleData.withUnsafeBytes { Array($0.bindMemory(to: Float.self)) }
+        guard scales.count == vocab, scales.allSatisfy({ $0.isFinite && $0 > 0 }) else {
+            throw KitGemmaError.bufferAllocationFailed("embed_per_layer.scale.f32")
+        }
+
+        let tableURL = directory.appendingPathComponent("embed_per_layer.i8")
+        let fd = open(tableURL.path, O_RDONLY)
+        guard fd >= 0 else {
+            throw KitGemmaError.missingTableFile("embed_per_layer.i8")
+        }
+        defer { close(fd) }
+        var fileInfo = stat()
+        guard fstat(fd, &fileInfo) == 0, fileInfo.st_size == tableBytes else {
+            throw KitGemmaError.bufferAllocationFailed("embed_per_layer.i8")
+        }
+        length = tableBytes
+        let mapped = mmap(nil, length, PROT_READ, MAP_PRIVATE, fd, 0)
+        guard let mapped, mapped != MAP_FAILED else {
+            throw KitGemmaError.bufferAllocationFailed("embed_per_layer.i8")
+        }
+        madvise(mapped, length, MADV_RANDOM)
+        base = UnsafeRawPointer(mapped)
+    }
+
+    deinit {
+        _ = munmap(UnsafeMutableRawPointer(mutating: base), length)
+    }
+
+    func fill(token: Int32, destination: UnsafeMutableRawPointer, byteCount: Int) {
+        let tokenIndex = Int(token)
+        guard tokenIndex >= 0, tokenIndex < scales.count,
+            byteCount == rowElements * MemoryLayout<Float16>.size
+        else {
+            memset(destination, 0, byteCount)
+            return
+        }
+        let row = base.advanced(by: tokenIndex * rowElements).assumingMemoryBound(to: Int8.self)
+        let output = destination.assumingMemoryBound(to: Float16.self)
+        let scale = scales[tokenIndex] * embeddingScale
+        for index in 0..<rowElements {
+            output[index] = Float16(Float(row[index]) * scale)
+        }
+    }
+}
